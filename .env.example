# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT secret – use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Admin credentials (single admin, stored in env)
ADMIN_EMAIL=admin@unwindcabins.com
ADMIN_PASSWORD=change-me-before-deploying

# The deployed Vercel frontend URL (no trailing slash)
# e.g. https://unwindcabins.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
